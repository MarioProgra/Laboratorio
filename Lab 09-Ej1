#include <iostream>
using namespace std;

void leerNumero(int &N) {
    do {
        cout << "Ingrese un numero entre 1 y 9999: ";
        cin >> N;

        if (N < 1 & N >= 10000) {
            cout << "Numero invalido. Intente de nuevo." << endl;
        }

    } while (N < 1 || N >= 10000);
}

void descomponerNumero(int N, int &u, int &d, int &c, int &m) {
    u = N % 10;
    d = (N / 10) % 10;
    c = (N / 100) % 10;
    m = (N / 1000) % 10;
}

void mostrarDigitos(int u, int d, int c, int m) {
    cout << "Unidad de mil (m): " << m << endl;
    cout << "Centena (c): " << c << endl;
    cout << "Decena (d): " << d << endl;
    cout << "Unidad (u): " << u << endl;
}

int main() {
    int N, u, d, c, m;

    leerNumero(N);
    descomponerNumero(N, u, d, c, m);
    mostrarDigitos(u, d, c, m);

    return 0;
}
