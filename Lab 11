
#include <iostream>
using namespace std;

void ingresarNotas(int notas[], int &cantidad);
void mostrarNotas(int notas[], int cantidad);
float calcularPromedio(int notas[], int cantidad);
void mayorYMenor(int notas[], int cantidad, int &mayor, int &menor);
void aprobadosReprobados(int notas[], int cantidad);
void buscarNota(int notas[], int cantidad);
void actualizarNota(int notas[], int cantidad);

int main() {
    int notas[30];
    int cantidad;
    int mayor, menor;

    cout << "REGISTRO Y ANALISIS DE CALIFICACIONES" << endl;

    ingresarNotas(notas, cantidad);

    cout << "\n--- NOTAS REGISTRADAS ---" << endl;
    mostrarNotas(notas, cantidad);

    cout << "\n--- PROMEDIO GENERAL ---" << endl;
    cout << "Promedio: " << calcularPromedio(notas, cantidad) << endl;

    cout << "\n--- NOTA MAYOR Y MENOR ---" << endl;
    mayorYMenor(notas, cantidad, mayor, menor);
    cout << "Nota mayor: " << mayor << endl;
    cout << "Nota menor: " << menor << endl;

    cout << "\n--- APROBADOS Y REPROBADOS ---" << endl;
    aprobadosReprobados(notas, cantidad);

    cout << "\n--- BUSCAR NOTA ---" << endl;
    buscarNota(notas, cantidad);

    cout << "\n--- ACTUALIZAR NOTA ---" << endl;
    actualizarNota(notas, cantidad);

    cout << "\n--- RESULTADOS ACTUALIZADOS ---" << endl;
    mostrarNotas(notas, cantidad);
    cout << "Nuevo promedio: "
         << calcularPromedio(notas, cantidad) << endl;

    return 0;
}

void ingresarNotas(int notas[], int &cantidad) {
    do {
        cout << "\nIngrese la cantidad de estudiantes (1-30): ";
        cin >> cantidad;

        if (cantidad < 1 || cantidad > 30) {
            cout << "Cantidad invalida. Intente nuevamente.\n";
        }

    } while (cantidad < 1 || cantidad > 30);

    for (int i = 0; i < cantidad; i++) {
        do {
            cout << "Ingrese la nota del estudiante "
                 << i + 1 << " (0-100): ";
            cin >> notas[i];

            if (notas[i] < 0 || notas[i] > 100) {
                cout << "Nota invalida. Debe estar entre 0 y 100.\n";
            }

        } while (notas[i] < 0 || notas[i] > 100);
    }
}

void mostrarNotas(int notas[], int cantidad) {
    for (int i = 0; i < cantidad; i++) {
        cout << "Estudiante " << i + 1
             << ": " << notas[i] << endl;
    }
}

float calcularPromedio(int notas[], int cantidad) {
    int suma = 0;

    for (int i = 0; i < cantidad; i++) {
        suma += notas[i];
    }

    return (float)suma / cantidad;
}

void mayorYMenor(int notas[], int cantidad,
                 int &mayor, int &menor) {
    mayor = notas[0];
    menor = notas[0];

    for (int i = 1; i < cantidad; i++) {
        if (notas[i] > mayor) {
            mayor = notas[i];
        }

        if (notas[i] < menor) {
            menor = notas[i];
        }
    }
}

void aprobadosReprobados(int notas[], int cantidad) {
    int aprobados = 0;
    int reprobados = 0;

    for (int i = 0; i < cantidad; i++) {
        if (notas[i] >= 51) {
            aprobados++;
        } else {
            reprobados++;
        }
    }

    cout << "Estudiantes aprobados: " << aprobados << endl;
    cout << "Estudiantes reprobados: " << reprobados << endl;
}

void buscarNota(int notas[], int cantidad) {
    int notaBuscada;
    bool encontrado = false;

    cout << "Ingrese la nota que desea buscar: ";
    cin >> notaBuscada;

    for (int i = 0; i < cantidad; i++) {
        if (notas[i] == notaBuscada) {
            cout << "La nota " << notaBuscada
                 << " pertenece al estudiante "
                 << i + 1 << endl;

            encontrado = true;
            break;
        }
    }

    if (!encontrado) {
        cout << "La nota no existe en el registro.\n";
    }
}

void actualizarNota(int notas[], int cantidad) {
    int estudiante;
    int nuevaNota;

    do {
        cout << "Ingrese el numero de estudiante (1-"
             << cantidad << "): ";
        cin >> estudiante;

        if (estudiante < 1 || estudiante > cantidad) {
            cout << "Numero de estudiante invalido.\n";
        }

    } while (estudiante < 1 || estudiante > cantidad);

    do {
        cout << "Ingrese la nueva nota (0-100): ";
        cin >> nuevaNota;

        if (nuevaNota < 0 || nuevaNota > 100) {
            cout << "Nota invalida. Intente nuevamente.\n";
        }

    } while (nuevaNota < 0 || nuevaNota > 100);

    notas[estudiante - 1] = nuevaNota;

    cout << "Nota actualizada correctamente.\n";
}
