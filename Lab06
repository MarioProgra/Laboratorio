#include <iostream>
using namespace std;

int main() {
    int N;
    double S = 0;

    cout << "Ingrese un numero entero positivo N: ";
    cin >> N;

    if (N <= 0) {
        cout << "El numero debe ser positivo." << endl;
    } else {
        int i = 1;

        while (i <= N) {
            S = S + 1.0 / i;
            i++;
        }

        cout << "La suma de la serie es: " << S << endl;
    }

    return 0;
}
