#include <iostream>
using namespace std;

void leerVentas(double &v1, double &v2, double &v3, double &v4, double &v5) {
    cout << "Ingrese las cinco ventas:" << endl;
    cin >> v1 >> v2 >> v3 >> v4 >> v5;
}

double procesarVentas(double v1, double v2, double v3, double v4, double v5) {
    return v1 + v2 + v3 + v4 + v5;
}

double calcularPromedio(double total) {
    return total / 5;
}

int contarDias(double v1, double v2, double v3, double v4, double v5, double promedio) {
    int dias = 0;

    if (v1 > promedio) dias++;
    if (v2 > promedio) dias++;
    if (v3 > promedio) dias++;
    if (v4 > promedio) dias++;
    if (v5 > promedio) dias++;

    return dias;
}

void mostrarResultados(double total, double promedio, int dias) {
    cout << "Total vendido: " << total << endl;
    cout << "Promedio diario: " << promedio << endl;
    cout << "Dias superiores al promedio: " << dias << endl;
}

int main() {
    double v1, v2, v3, v4, v5;
    double total, promedio;
    int dias;

    leerVentas(v1, v2, v3, v4, v5);
    total = procesarVentas(v1, v2, v3, v4, v5);
    promedio = calcularPromedio(total);
    dias = contarDias(v1, v2, v3, v4, v5, promedio);

    mostrarResultados(total, promedio, dias);

    return 0;
}
