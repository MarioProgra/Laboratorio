
#include <iostream>
#include <string>
using namespace std;

void Leer(string &a, string &b);
int BuscarSubCadena(string a, string b);
void Mostrar(int resultado);

int main() {
    string a, b;
    int resultado;

    Leer(a, b);
    resultado = BuscarSubCadena(a, b);
    Mostrar(resultado);

    return 0;
}

void Leer(string &a, string &b) {
    cout << "Ingrese la cadena: ";
    getline(cin, a);

    cout << "Ingrese la subcadena: ";
    getline(cin, b);
}
int BuscarSubCadena(string a, string b) {
    size_t pos = a.find(b);

    if (pos == string::npos) {
        return -1;
    }

    return pos;
}
void Mostrar(int resultado) {
    cout << "La posicion es: " << resultado << endl;
}
